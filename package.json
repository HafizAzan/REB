{
  "name": "estatex",
  "private": true,
  "version": "0.1.0",
  "description": "EstateX — premium real estate marketplace",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@estatex/web",
    "dev:api": "turbo dev --filter=@estatex/api",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate --workspace=@estatex/api",
    "db:seed": "npm run prisma:seed --workspace=@estatex/api",
    "db:studio": "npm run prisma:studio --workspace=@estatex/api",
    "postinstall": "npm run prisma:generate --workspace=@estatex/api --if-present"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.17.0"
}
